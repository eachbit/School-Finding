{
  "info": {
    "name": "School-Finding 校园失物招领智能匹配系统",
    "description": "后端接口集合。按目录顺序 0→4 执行即可跑通主流程：登录→发布→审核→搜索→匹配→认领→审核→交接→统计→日志。\n\n前置：已执行 sql/init.sql，服务已在 http://localhost:8080 启动。\n\n变量：baseUrl / token / adminToken / itemId（新建信息 id）/ claimId（新建申请 id），登录与发布请求会自动写入变量。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "claimId", "value": "" }
  ],
  "item": [
    {
      "name": "0. 认证",
      "item": [
        {
          "name": "0.1 登录 student1（自动存 token）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "预期：code=0，data.token 有值，role=STUDENT"
          }
        },
        {
          "name": "0.2 登录 admin（自动存 adminToken）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('role=ADMIN', () => pm.expect(pm.response.json().data.role).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "预期：code=0，role=ADMIN"
          }
        },
        {
          "name": "0.3 注册学生",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student9\",\n  \"password\": \"123456\",\n  \"contact\": \"13800000009\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "预期：code=0，返回 token 与 role=STUDENT。重复执行会返回 code=400 用户名已存在。"
          }
        },
        {
          "name": "0.4 当前用户",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            },
            "description": "预期：code=0，返回 student1 的信息（不含 password 字段）"
          }
        },
        {
          "name": "0.5 未登录访问（应 401）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"]
            },
            "description": "不带 Authorization 头，预期 code=401"
          }
        },
        {
          "name": "0.6 学生调管理员接口（应 403）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "statistics"]
            },
            "description": "用学生 token 调管理端接口，预期 code=403"
          }
        }
      ]
    },
    {
      "name": "1. 信息发布与查询",
      "item": [
        {
          "name": "1.1 发布失物（自动存 itemId）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态为 PENDING', () => pm.expect(pm.response.json().data.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('itemId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"LOST\",\n  \"title\": \"丢失一个黑色钱包\",\n  \"description\": \"在第二食堂一楼吃完饭把黑色钱包落在餐桌上了。\",\n  \"category\": \"钱包\",\n  \"location\": \"第二食堂一楼\",\n  \"happenTime\": \"2026-10-22 15:00:00\",\n  \"color\": \"黑色\",\n  \"contact\": \"13800000001\",\n  \"hiddenFeature\": \"钱包内有一张校园卡和一张照片\",\n  \"verifyQuestion\": \"钱包里除了校园卡还有什么？\",\n  \"verifyAnswer\": \"一张照片\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"]
            },
            "description": "预期：code=0，status=PENDING。发布后不会出现在公开列表，必须管理员审核。"
          }
        },
        {
          "name": "1.2 公开列表（分页 + 筛选）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items?type=FOUND&category=&location=&keyword=&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"],
              "query": [
                { "key": "type", "value": "FOUND" },
                { "key": "category", "value": "" },
                { "key": "location", "value": "" },
                { "key": "keyword", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "预期：只返回 status=PUBLIC 的信息；记录里没有 contact / hiddenFeature / verifyAnswer 字段。"
          }
        },
        {
          "name": "1.3 详情（看验证问题，不含答案）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "1"]
            },
            "description": "预期：有 verifyQuestion，没有 verifyAnswer / contact / hiddenFeature。用发布者本人 token 调才会返回 contact。"
          }
        },
        {
          "name": "1.4 我的发布",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/me/items?status=&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "items"],
              "query": [
                { "key": "status", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "预期：返回 student1 自己发布的信息，含 reviewOpinion（审核意见）与 contact。"
          }
        },
        {
          "name": "1.5 关闭我的信息",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items/2/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "2", "close"]
            },
            "description": "预期：仅 PUBLIC 状态可关闭，返回 status=CLOSED。已关闭后可再调 /reopen 回到 PENDING。"
          }
        },
        {
          "name": "1.6 关闭后重新发布",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items/2/reopen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "2", "reopen"]
            },
            "description": "预期：CLOSED → PENDING，需要重新审核。"
          }
        }
      ]
    },
    {
      "name": "2. 规则匹配",
      "item": [
        {
          "name": "2.1 失物匹配拾物",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/matches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "{{itemId}}", "matches"]
            },
            "description": "预期：返回 score ≥ 60 的前 5 条，按分数倒序，带 reasons 理由数组。分数只是规则相似度。"
          }
        },
        {
          "name": "2.2 拾物匹配失物",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/items/3/matches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "3", "matches"]
            },
            "description": "预期：拾物 id=3（白色充电宝）匹配失物，返回对应失物条目。"
          }
        }
      ]
    },
    {
      "name": "3. 认领申请（学生）",
      "item": [
        {
          "name": "3.1 提交认领（自动存 claimId）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('claimId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proof\": \"充电宝外壳贴了小熊贴纸，背面还有一条浅划痕\",\n  \"answer\": \"卡通贴纸\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/3/claims",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "3", "claims"]
            },
            "description": "预期：code=0，status=PENDING。注意：不能认领自己发布的信息；同一用户同一物品只能有一条有效申请（会返回 400）。"
          }
        },
        {
          "name": "3.2 我的申请",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/me/claims",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "claims"]
            },
            "description": "预期：只返回自己的申请，含自己的 proof / answer。"
          }
        },
        {
          "name": "3.3 取消待审核申请",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "{{claimId}}", "cancel"]
            },
            "description": "预期：code=0，状态变 CANCELLED（仅 PENDING 可取消）。"
          }
        }
      ]
    },
    {
      "name": "4. 管理端",
      "item": [
        {
          "name": "4.1 待审核信息列表",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/items?status=PENDING&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "items"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "预期：含 1.1 刚发布的信息（id={{itemId}}），并带出 contact / hiddenFeature / verifyAnswer。"
          }
        },
        {
          "name": "4.2 审核信息通过",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pass\": true,\n  \"opinion\": \"信息完整，通过\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/items/{{itemId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "items", "{{itemId}}", "review"]
            },
            "description": "预期：status 变 PUBLIC，之后公开列表能搜到；重复审核返回 400。驳回时 opinion 必填。"
          }
        },
        {
          "name": "4.3 待审核认领列表",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/claims?status=PENDING&page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "claims"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "预期：返回待审核申请列表（含申请人、物品标题）。"
          }
        },
        {
          "name": "4.4 认领详情（含隐藏特征与答案）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/claims/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "claims", "1"]
            },
            "description": "预期：返回 itemHiddenFeature / itemVerifyQuestion / itemVerifyAnswer，供管理员核对申请人证明。"
          }
        },
        {
          "name": "4.5 认领审核通过",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "{{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pass\": true,\n  \"opinion\": \"证明与隐藏特征一致，通过\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/claims/1/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "claims", "1", "review"]
            },
            "description": "预期：status=APPROVED。同一物品已有通过的申请时，第二个申请会返回 400。"
          }
        },
        {
          "name": "4.6 撤销已通过的申请",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/claims/1/revoke?opinion=证明不足",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "claims", "1", "revoke"],
              "query": [{ "key": "opinion", "value": "证明不足" }]
            },
            "description": "预期：status=REVOKED，物品仍为 PUBLIC，可以再通过别人的申请；opinion 必填。"
          }
        },
        {
          "name": "4.7 交接确认",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/claims/1/handover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "claims", "1", "handover"]
            },
            "description": "预期：申请变 HANDED、物品变 CLAIMED；重复调用返回 400 且不新增日志。"
          }
        },
        {
          "name": "4.8 统计（3 个数字）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "statistics"]
            },
            "description": "预期：{publicFoundCount, claimedFoundCount, pendingClaimCount}"
          }
        },
        {
          "name": "4.9 最近操作日志",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/logs?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "logs"],
              "query": [{ "key": "limit", "value": "20" }]
            },
            "description": "预期：按时间倒序，包含 ITEM_REVIEW / CLAIM_REVIEW / CLAIM_HANDOVER 等动作、操作人和意见。"
          }
        }
      ]
    }
  ]
}
